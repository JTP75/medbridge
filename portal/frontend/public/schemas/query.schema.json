{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://medbridge.dev/schema/query.schema.json",
  "title": "DiscoveryQuery",
  "description": "Sent by the Portal to a hospital node's /api/beacon/query endpoint. All fields optional except query_id — an empty query means 'match everything'. Filter enums mirror imaging_record.schema.json's controlled vocabularies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id"],
  "properties": {
    "query_id": {
      "type": "string",
      "description": "Caller-generated id for correlating this query across nodes/responses."
    },
    "modality": {
      "type": "string",
      "description": "Filter by imaging modality.",
      "enum": ["MR", "CT", "US", "XR", "PT", "NM", "MG", "OT"]
    },
    "body_part": {
      "type": "string",
      "description": "Filter by broad body site.",
      "enum": ["BRAIN", "HEART", "FETAL", "CHEST", "ABDOMEN", "SPINE", "OTHER"]
    },
    "age_band": {
      "type": "string",
      "description": "Filter by bucketed age range.",
      "enum": ["0-1", "2-5", "6-12", "13-21", "22-40", "41-64", "65-89", "90+"]
    },
    "sex": {
      "type": "string",
      "description": "Filter by administrative sex.",
      "enum": ["F", "M", "O", "U"]
    },
    "acquisition_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100,
      "description": "Filter by acquisition year."
    },
    "condition_category": {
      "type": "string",
      "description": "Filter by normalized condition/ontology bucket.",
      "enum": [
        "neoplasm",
        "ischemia",
        "hemorrhage",
        "congenital_anomaly",
        "inflammatory",
        "degenerative",
        "normal",
        "other"
      ]
    }
  }
}
